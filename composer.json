{
    "name": "escall/plataforma",
    "type": "project",
    "description": "Plataforma ESCALL de clientes, acuerdos, propuestas y seguimientos.",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "dompdf/dompdf": "^3.1.6",
        "inertiajs/inertia-laravel": "^2.0",
        "laravel/framework": "^12.69.2",
        "openspout/openspout": "4.24.5",
        "phpmailer/phpmailer": "^6.12",
        "phpoffice/phpspreadsheet": "^2.4.7",
        "phpoffice/phpword": "^1.4",
        "setasign/fpdf": "^1.9",
        "setasign/fpdi": "^2.6.8",
        "tecnickcom/tcpdf": "^6.11.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "@php artisan test"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

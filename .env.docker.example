# Copy this file to .env.docker only if you want to override the deliberately
# fake Docker-only passwords below. Never place production credentials here.
ESCALL_DB_PASSWORD=escall_local_only
ESCALL_DB_ROOT_PASSWORD=escall_root_local_only

# Optional and local-only: set both before running DockerDevelopmentSeeder.
# Do not commit the copied .env.docker file or use production credentials.
ESCALL_DEMO_ADMIN_USER=
ESCALL_DEMO_ADMIN_PASSWORD=
ESCALL_DEMO_ADMIN_NAME=Administrador de demostración
